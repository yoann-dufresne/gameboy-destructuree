#pragma once

/* Le réseau que le module écran émet : ECRAN_SSID et ECRAN_MOT_DE_PASSE dans
 * le secrets.h de sa tête (ecran/firmware/tete/include/secrets.h). */
#define WIFI_SSID     "ecran-led"
#define WIFI_PASSWORD "mot-de-passe-de-l-ecran"

/* Code pays pour la réglementation radio. FR pour la France. */
#define WIFI_PAYS CYW43_COUNTRY_FRANCE
