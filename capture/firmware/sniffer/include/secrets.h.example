/* Identifiants WiFi — COPIER EN secrets.h ET REMPLIR.
 *
 * secrets.h est ignoré par git : les identifiants ne doivent jamais être
 * versionnés.
 *
 *     cp include/secrets.h.example include/secrets.h
 *     $EDITOR include/secrets.h
 */
#pragma once

/* Le réseau que le module écran émet : ECRAN_SSID et ECRAN_MOT_DE_PASSE dans
 * le secrets.h de sa tête (ecran/firmware/tete/include/secrets.h). */
#define WIFI_SSID     "ecran-led"
#define WIFI_PASSWORD "mot-de-passe-de-l-ecran"

/* Option POINT_ACCES seulement (banc R2) : le réseau image que le sniffer
 * émet lui-même. Le même mot de passe que BANC_MOT_DE_PASSE dans
 * banc-reseau/firmware/include/secrets.h, pour que les faux écrans s'y joignent. */
#define IMAGE_SSID         "gb-image"
#define IMAGE_MOT_DE_PASSE "choisir-un-mot-de-passe"

/* Code pays pour la réglementation radio. FR pour la France. */
#define WIFI_PAYS CYW43_COUNTRY_FRANCE
