/* Identifiants WiFi du banc — COPIER EN secrets.h ET REMPLIR.
 *
 * secrets.h est ignoré par git : les identifiants ne doivent jamais être
 * versionnés.
 *
 *     cp include/secrets.h.example include/secrets.h
 *     $EDITOR include/secrets.h
 */
#pragma once

/* Un seul mot de passe pour les quatre réseaux du banc : gb-image, gb-son,
 * gb-manettes, gb-cartouche. WPA2 : 8 caractères au moins.
 *
 * Pour le banc R2, le sniffer émet gb-image avec IMAGE_MOT_DE_PASSE, dans le
 * secrets.h du module capture : y mettre le même. */
#define BANC_MOT_DE_PASSE "choisir-un-mot-de-passe"

/* Code pays pour la réglementation radio. FR pour la France. */
#define WIFI_PAYS CYW43_COUNTRY_FRANCE
