/* Identifiants WiFi — COPIER EN secrets.h ET REMPLIR.
 *
 * secrets.h est ignoré par git : les identifiants ne doivent jamais être
 * versionnés.
 *
 *     cp include/secrets.h.example include/secrets.h
 *     $EDITOR include/secrets.h
 */
#pragma once

/* Le réseau que l'écran émet : les sources (Game Boy, PC) s'y connectent.
 * Mot de passe WPA2 : 8 caractères au moins. */
#define ECRAN_SSID         "ecran-led"
#define ECRAN_MOT_DE_PASSE "choisir-un-mot-de-passe"

/* Mode station seulement (option CMake WIFI_STATION) : la box à rejoindre. */
#define WIFI_SSID     "nom-de-ton-reseau"
#define WIFI_PASSWORD "mot-de-passe"

/* Code pays pour la réglementation radio. FR pour la France. */
#define WIFI_PAYS CYW43_COUNTRY_FRANCE
